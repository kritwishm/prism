# Sanity — mirror values from ../.env (the Python pipeline)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: server-side token if your dataset is private.
# A Viewer-role token is sufficient — render is read-only.
SANITY_READ_TOKEN=

# Shared secret with Sanity webhook → /api/revalidate
# Generate any random string; set the same in Sanity webhook config.
REVALIDATE_SECRET=change-me
